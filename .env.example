# --- Bridge (this Node server) ---
BRIDGE_PORT=3000

# --- CrispASR ASR (you -> text) ---
# Backends: parakeet (best English, ~0.6B) | whisper | moonshine | sensevoice ...
ASR_BACKEND=parakeet
ASR_LANGUAGE=en
# Trailing silence (ms) after which an utterance is finalized and sent to the LLM
ASR_FINAL_SILENCE_MS=800
# ggml threads for ASR (this box: 20-core Ultra 9; 8 is a good default)
ASR_THREADS=8

# --- CrispASR TTS (agent -> you) ---
# Kokoro is the fast non-autoregressive choice for CPU (24 kHz mono out)
TTS_BACKEND=kokoro
TTS_PORT=8091
TTS_THREADS=8
# Optional kokoro voice (e.g. af_heart, am_michael, bf_emma). Empty = default.
TTS_VOICE=
# Native output sample rate of the TTS backend (kokoro = 24000)
TTS_SAMPLE_RATE=24000

# --- LLM (any OpenAI-compatible /chat/completions endpoint) ---
# Leave LLM_BASE_URL empty to use the built-in echo bot (audio pipeline still works)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Conversation ---
SYSTEM_PROMPT=You are a voice assistant. Keep answers short and conversational: one to three sentences. No lists, no markdown, no emoji — your reply is read aloud by a text-to-speech engine.
